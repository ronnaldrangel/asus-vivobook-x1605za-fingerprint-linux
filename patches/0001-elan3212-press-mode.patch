+static void
+elanspi_press_capture_ssm_handler (FpiSsm *ssm, FpDevice *dev)
+{
+  FpiDeviceElanSpi *self = FPI_DEVICE_ELANSPI (dev);
+  FpiSsm *chld = NULL;
+
+  if (self->deactivating)
+    {
+      fpi_ssm_mark_completed (ssm);
+      return;
+    }
+
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case ELANSPI_PRESS_WAIT_DOWN_CAPTURE:
+    case ELANSPI_PRESS_CAPTURE_FIRST:
+    case ELANSPI_PRESS_CAPTURE_SECOND:
+    case ELANSPI_PRESS_WAIT_UP_CAPTURE:
+      chld = fpi_ssm_new (dev, elanspi_capture_hv_handler,
+                          ELANSPI_CAPTHV_NSTATES);
+      fpi_ssm_silence_debug (chld);
+      fpi_ssm_start_subsm (ssm, chld);
+      return;
+
+    case ELANSPI_PRESS_WAIT_DOWN_PROCESS:
+      if (!elanspi_check_waitupdown_done (self, ELANSPI_GUESS_FINGERPRINT))
+        {
+          fpi_ssm_jump_to_state (ssm, ELANSPI_PRESS_WAIT_DOWN_CAPTURE);
+          return;
+        }
+
+      self->finger_wait_debounce = 0;
+      fpi_image_device_report_finger_status (FP_IMAGE_DEVICE (self), TRUE);
+      fpi_ssm_jump_to_state_delayed (ssm, ELANSPI_PRESS_SETTLE,
+                                     ELANSPI_PRESS_SETTLE_DELAY);
+      return;
+
+    case ELANSPI_PRESS_SETTLE:
+      fpi_ssm_next_state (ssm);
+      return;
+
+    case ELANSPI_PRESS_PROCESS:
+      elanspi_press_submit_image (self);
+      fpi_ssm_next_state (ssm);
+      return;
+
+    case ELANSPI_PRESS_WAIT_UP_PROCESS:
+      if (!elanspi_check_waitupdown_done (self, ELANSPI_GUESS_EMPTY))
+        {
+          fpi_ssm_jump_to_state (ssm, ELANSPI_PRESS_WAIT_UP_CAPTURE);
+          return;
+        }
+
+      self->capturing = FALSE;
+      fpi_image_device_report_finger_status (FP_IMAGE_DEVICE (self), FALSE);
+      fpi_ssm_mark_completed (ssm);
+      return;
+    }
+}
