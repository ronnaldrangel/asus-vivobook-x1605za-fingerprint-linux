+/* Process the complete sensor image. The swipe path intentionally limits
+ * frames to 43 rows; press sensors need the full 80x80 area in one shot. */
+static void
+elanspi_process_full_frame (FpiDeviceElanSpi *self,
+                            const guint16 *data_in,
+                            guint8 *data_out)
+{
+  int rotation = fpi_device_get_driver_data (FP_DEVICE (self)) & 3;
+  guint out_width = self->sensor_width;
+  guint out_height = self->sensor_height;
+  size_t frame_size;
+  g_autofree guint16 *data_in_sorted = NULL;
+  guint16 lvl0, lvl1, lvl2, lvl3;
+
+  if (rotation == ELANSPI_90LEFT_ROTATE ||
+      rotation == ELANSPI_90RIGHT_ROTATE)
+    {
+      out_width = self->sensor_height;
+      out_height = self->sensor_width;
+    }
+
+  frame_size = (size_t) out_width * out_height;
+  data_in_sorted = g_malloc (frame_size * sizeof (guint16));
+
+  for (guint i = 0, offset = 0; i < out_height; i += 1)
+    for (guint j = 0; j < out_width; j += 1)
+      data_in_sorted[offset++] =
+        elanspi_lookup_pixel_with_rotation (self, data_in, i, j);
+
+  qsort (data_in_sorted, frame_size, sizeof (guint16), cmp_u16);
+  lvl0 = data_in_sorted[0];
+  lvl1 = data_in_sorted[frame_size * 3 / 10];
+  lvl2 = data_in_sorted[frame_size * 65 / 100];
+  lvl3 = data_in_sorted[frame_size - 1];
+
+  lvl1 = MAX (lvl1, lvl0 + 1);
+  lvl2 = MAX (lvl2, lvl1 + 1);
+  lvl3 = MAX (lvl3, lvl2 + 1);
+
+  for (guint i = 0; i < out_height; i += 1)
+    {
+      for (guint j = 0; j < out_width; j += 1)
+        {
+          guint16 px = elanspi_lookup_pixel_with_rotation (self, data_in, i, j);
+
+          if (px < lvl0)
+            px = 0;
+          else if (px > lvl3)
+            px = 255;
+          else if (px < lvl1)
+            px = (px - lvl0) * 99 / (lvl1 - lvl0);
+          else if (px < lvl2)
+            px = 99 + ((px - lvl1) * 56 / (lvl2 - lvl1));
+          else
+            px = 155 + ((px - lvl2) * 100 / (lvl3 - lvl2));
+
+          *data_out = px;
+          data_out += 1;
+        }
+    }
+}
