+static void
+elanspi_dump_image (FpImage *img)
+{
+  g_autofree gchar *path = NULL;
+
+  g_mkdir_with_parents ("/var/lib/fprint/debug", 0755);
+  path = g_strdup_printf ("/var/lib/fprint/debug/elan3212-%" G_GINT64_FORMAT ".pgm",
+                          g_get_real_time ());
+  FILE *fp = fopen (path, "wb");
+  if (!fp)
+    return;
+  fprintf (fp, "P5\n%d %d\n255\n", img->width, img->height);
+  fwrite (img->data, 1, (gsize) img->width * img->height, fp);
+  fclose (fp);
+}
+
+static void
+elanspi_press_submit_image (FpiDeviceElanSpi *self)
+{
+  int rotation = fpi_device_get_driver_data (FP_DEVICE (self)) & 3;
+  guint width = self->sensor_width;
+  guint height = self->sensor_height;
+  g_autoptr(FpImage) img = NULL;
+
+  if (rotation == ELANSPI_90LEFT_ROTATE ||
+      rotation == ELANSPI_90RIGHT_ROTATE)
+    {
+      width = self->sensor_height;
+      height = self->sensor_width;
+    }
+
+  img = fp_image_new (width, height);
+  elanspi_correct_with_bg (self, self->last_image);
+  elanspi_process_full_frame (self, self->last_image, img->data);
+  elanspi_smooth_image (img);
+  if (g_getenv ("ELANSPI_DEBUG_DUMP"))
+    elanspi_dump_image (img);
+  img->flags |= FPI_IMAGE_COLORS_INVERTED;
+
+  fpi_image_device_image_captured (FP_IMAGE_DEVICE (self),
+                                   g_steal_pointer (&img));
+}
